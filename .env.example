# Copy this file to .env.local and fill in real values. Never commit .env.local.

# NewsData.io API key (server-only — never expose as NEXT_PUBLIC_*).
# The newsroom's NewsData provider degrades to an "unavailable" result when
# this is unset; it does not crash. See docs/NEWS-SOURCE-STRATEGY.md.
NEWSDATA_API_KEY=

# --- Persistent news warehouse (Phase 4) — SERVER-ONLY -----------------------
# The warehouse is written and read only by server-side code (CLI scripts today,
# the scheduled newsroom engine later). Nothing here may ever be NEXT_PUBLIC_*,
# and no public/publishable Supabase key is needed until a feature reads
# warehouse data from the browser (none does yet).
#
# Local development: run `pnpm db:start`, then copy the API URL and SECRET_KEY
# from `pnpm db:status -o env` (the local key starts with sb_secret_).
SUPABASE_URL=
# Supabase secret key (sb_secret_…). Bypasses RLS — never expose it.
SUPABASE_SECRET_KEY=
# Legacy fallback ONLY for a project that has not migrated to secret keys yet
# (the old service_role JWT). Leave unset otherwise.
# SUPABASE_SERVICE_ROLE_KEY=
